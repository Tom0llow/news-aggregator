# Autonomous development execution policy.
#
# Important:
# - `allow` means run outside the sandbox without an extra approval prompt.
# - Git/GitHub network operations intentionally rely on these host-side rules.
# - Windows path/executable spellings are enumerated to avoid accidental
#   sandbox fallback (`127.0.0.1:9` proxy failures).

# ---------------------------------------------------------------------------
# Read-only Git inspection
# ---------------------------------------------------------------------------

prefix_rule(
    pattern = [["git", "git.exe"], "status"],
    decision = "allow",
    justification = "Read-only repository inspection.",
)
prefix_rule(
    pattern = [["git", "git.exe"], "diff"],
    decision = "allow",
    justification = "Read-only diff inspection.",
)
prefix_rule(
    pattern = [["git", "git.exe"], "log"],
    decision = "allow",
    justification = "Read-only history inspection.",
)
prefix_rule(
    pattern = [["git", "git.exe"], "show"],
    decision = "allow",
    justification = "Read-only object inspection.",
)
prefix_rule(
    pattern = [["git", "git.exe"], "rev-parse"],
    decision = "allow",
    justification = "Read-only revision inspection.",
)
prefix_rule(
    pattern = [["git", "git.exe"], "merge-base"],
    decision = "allow",
    justification = "Read-only revision calculation.",
)
prefix_rule(
    pattern = [["git", "git.exe"], "ls-files"],
    decision = "allow",
    justification = "Read-only tracked-file listing.",
)
prefix_rule(
    pattern = [["git", "git.exe"], "branch", "--show-current"],
    decision = "allow",
    justification = "Read-only current branch inspection.",
)

# ---------------------------------------------------------------------------
# Read-only GitHub commands
# ---------------------------------------------------------------------------

# Do not use `gh auth status` in Codex. In sandbox/headless execution it can
# produce misleading keyring diagnostics. Authentication is verified by the
# guarded preflight via an actual API request.
prefix_rule(
    pattern = [["gh", "gh.exe"], "auth", "status"],
    decision = "forbidden",
    justification = "Use scripts/agent/github-preflight.ps1 instead of direct gh auth status.",
)

prefix_rule(
    pattern = [["gh", "gh.exe"], "repo", "view"],
    decision = "allow",
    justification = "Read-only GitHub repository metadata.",
)
prefix_rule(
    pattern = [["gh", "gh.exe"], "pr", "view"],
    decision = "allow",
    justification = "Read-only pull request metadata.",
)
prefix_rule(
    pattern = [["gh", "gh.exe"], "pr", "diff"],
    decision = "allow",
    justification = "Read-only pull request diff.",
)
prefix_rule(
    pattern = [["gh", "gh.exe"], "pr", "checks"],
    decision = "allow",
    justification = "Read-only pull request CI status.",
)
prefix_rule(
    pattern = [["gh", "gh.exe"], "pr", "status"],
    decision = "allow",
    justification = "Read-only pull request status.",
)
prefix_rule(
    pattern = [["gh", "gh.exe"], "run", "list"],
    decision = "allow",
    justification = "Read-only Actions run listing.",
)
prefix_rule(
    pattern = [["gh", "gh.exe"], "run", "view"],
    decision = "allow",
    justification = "Read-only Actions run/log inspection.",
)

# ---------------------------------------------------------------------------
# Routine local validation
# ---------------------------------------------------------------------------

prefix_rule(pattern = ["uv", "run", "pytest"], decision = "allow", justification = "Repository tests.")
prefix_rule(pattern = ["uv", "run", "ruff", "check"], decision = "allow", justification = "Repository lint.")
prefix_rule(pattern = ["uv", "run", "ruff", "format", "--check"], decision = "allow", justification = "Formatting check.")
prefix_rule(pattern = ["uv", "run", "mypy"], decision = "allow", justification = "Static type checking.")

# ---------------------------------------------------------------------------
# Guarded autonomous wrappers
# ---------------------------------------------------------------------------

prefix_rule(
    pattern = [
        ["pwsh", "pwsh.exe", "powershell.exe"],
        "-NoProfile",
        "-File",
        [
            "scripts/agent/github-preflight.ps1",
            "./scripts/agent/github-preflight.ps1",
            ".\\scripts\\agent\\github-preflight.ps1",
            "scripts\\agent\\github-preflight.ps1",
        ],
    ],
    decision = "allow",
    justification = "Host-side GitHub authentication, baseline CI, origin, and branch-protection preflight.",
    match = [
        ["pwsh", "-NoProfile", "-File", "scripts/agent/github-preflight.ps1"],
        ["pwsh.exe", "-NoProfile", "-File", ".\\scripts\\agent\\github-preflight.ps1"],
    ],
)

prefix_rule(
    pattern = [
        ["pwsh", "pwsh.exe", "powershell.exe"],
        "-NoProfile",
        "-File",
        [
            "scripts/agent/start-task.ps1",
            "./scripts/agent/start-task.ps1",
            ".\\scripts\\agent\\start-task.ps1",
            "scripts\\agent\\start-task.ps1",
        ],
    ],
    decision = "allow",
    justification = "Creates only a clean origin/main-based agent/* task branch.",
    match = [["pwsh", "-NoProfile", "-File", "scripts/agent/start-task.ps1", "-TaskName", "example"]],
)

prefix_rule(
    pattern = [
        ["pwsh", "pwsh.exe", "powershell.exe"],
        "-NoProfile",
        "-File",
        [
            "scripts/agent/commit-task.ps1",
            "./scripts/agent/commit-task.ps1",
            ".\\scripts\\agent\\commit-task.ps1",
            "scripts\\agent\\commit-task.ps1",
        ],
    ],
    decision = "allow",
    justification = "Guarded task commit with secret-path and message checks.",
)

prefix_rule(
    pattern = [
        ["pwsh", "pwsh.exe", "powershell.exe"],
        "-NoProfile",
        "-File",
        [
            "scripts/agent/push-task.ps1",
            "./scripts/agent/push-task.ps1",
            ".\\scripts\\agent\\push-task.ps1",
            "scripts\\agent\\push-task.ps1",
        ],
    ],
    decision = "allow",
    justification = "Pushes only HEAD to the recorded agent/* branch on origin, never force.",
    match = [["pwsh", "-NoProfile", "-File", "scripts/agent/push-task.ps1"]],
)

prefix_rule(
    pattern = [
        ["pwsh", "pwsh.exe", "powershell.exe"],
        "-NoProfile",
        "-File",
        [
            "scripts/agent/create-pr.ps1",
            "./scripts/agent/create-pr.ps1",
            ".\\scripts\\agent\\create-pr.ps1",
            "scripts\\agent\\create-pr.ps1",
        ],
    ],
    decision = "allow",
    justification = "Creates only the recorded task PR with matching local/remote HEAD.",
)

prefix_rule(
    pattern = [
        ["pwsh", "pwsh.exe", "powershell.exe"],
        "-NoProfile",
        "-File",
        [
            "scripts/agent/wait-ci.ps1",
            "./scripts/agent/wait-ci.ps1",
            ".\\scripts\\agent\\wait-ci.ps1",
            "scripts\\agent\\wait-ci.ps1",
        ],
    ],
    decision = "allow",
    justification = "Polls required PR checks for the guarded task.",
)

prefix_rule(
    pattern = [
        ["pwsh", "pwsh.exe", "powershell.exe"],
        "-NoProfile",
        "-File",
        [
            "scripts/agent/merge-ready.ps1",
            "./scripts/agent/merge-ready.ps1",
            ".\\scripts\\agent\\merge-ready.ps1",
            "scripts\\agent\\merge-ready.ps1",
        ],
    ],
    decision = "allow",
    justification = "Read-only exact-HEAD merge-readiness gate.",
)

prefix_rule(
    pattern = [
        ["pwsh", "pwsh.exe", "powershell.exe"],
        "-NoProfile",
        "-File",
        [
            "scripts/agent/merge-task.ps1",
            "./scripts/agent/merge-task.ps1",
            ".\\scripts\\agent\\merge-task.ps1",
            "scripts\\agent\\merge-task.ps1",
        ],
    ],
    decision = "prompt",
    justification = "Final merge is the hard human approval boundary.",
    match = [
        [
            "pwsh",
            "-NoProfile",
            "-File",
            "scripts/agent/merge-task.ps1",
            "-PrNumber",
            "1",
            "-ExpectedHeadSha",
            "0123456789012345678901234567890123456789",
        ]
    ],
)

# One-time/admin repository policy.
prefix_rule(
    pattern = [
        ["pwsh", "pwsh.exe", "powershell.exe"],
        "-NoProfile",
        "-File",
        [
            "scripts/github/configure-main-protection.ps1",
            "./scripts/github/configure-main-protection.ps1",
            ".\\scripts\\github\\configure-main-protection.ps1",
            "scripts\\github\\configure-main-protection.ps1",
        ],
    ],
    decision = "prompt",
    justification = "Changes server-side repository/branch policy.",
)
prefix_rule(
    pattern = [
        ["pwsh", "pwsh.exe", "powershell.exe"],
        "-NoProfile",
        "-File",
        [
            "scripts/github/verify-main-protection.ps1",
            "./scripts/github/verify-main-protection.ps1",
            ".\\scripts\\github\\verify-main-protection.ps1",
            "scripts\\github\\verify-main-protection.ps1",
        ],
    ],
    decision = "allow",
    justification = "Read-only verification of repository and main protection policy.",
)

# ---------------------------------------------------------------------------
# Raw mutation paths are forbidden to Codex
# ---------------------------------------------------------------------------

prefix_rule(pattern = [["git", "git.exe"], "add"], decision = "forbidden", justification = "Use guarded commit-task.ps1.")
prefix_rule(pattern = [["git", "git.exe"], "commit"], decision = "forbidden", justification = "Use guarded commit-task.ps1.")
prefix_rule(pattern = [["git", "git.exe"], "push"], decision = "forbidden", justification = "Use guarded push-task.ps1.")
prefix_rule(pattern = [["git", "git.exe"], "switch"], decision = "forbidden", justification = "Use guarded start/merge wrappers.")
prefix_rule(pattern = [["git", "git.exe"], "checkout"], decision = "forbidden", justification = "Raw checkout can switch/discard outside the guarded workflow.")
prefix_rule(pattern = [["git", "git.exe"], "restore"], decision = "forbidden", justification = "Raw restore can discard task/user changes.")
prefix_rule(pattern = [["git", "git.exe"], "merge"], decision = "forbidden", justification = "Raw merge bypasses workflow guards.")
prefix_rule(pattern = [["git", "git.exe"], "rebase"], decision = "forbidden", justification = "Raw rebase rewrites history.")
prefix_rule(pattern = [["git", "git.exe"], "cherry-pick"], decision = "forbidden", justification = "Raw cherry-pick changes history outside the workflow.")
prefix_rule(pattern = [["git", "git.exe"], "reset", "--hard"], decision = "forbidden", justification = "Can irreversibly discard work.")
prefix_rule(pattern = [["git", "git.exe"], "clean", "-fd"], decision = "forbidden", justification = "Can irreversibly delete untracked content.")
prefix_rule(pattern = [["git", "git.exe"], "clean", "-fdx"], decision = "forbidden", justification = "Can irreversibly delete ignored/untracked content.")

prefix_rule(pattern = [["gh", "gh.exe"], "pr", "create"], decision = "forbidden", justification = "Use guarded create-pr.ps1.")
prefix_rule(pattern = [["gh", "gh.exe"], "pr", "merge"], decision = "forbidden", justification = "Use human-approved guarded merge-task.ps1.")
prefix_rule(pattern = [["gh", "gh.exe"], "pr", "close"], decision = "forbidden", justification = "Remote mutation outside the autonomous contract.")
prefix_rule(pattern = [["gh", "gh.exe"], "repo", "delete"], decision = "forbidden", justification = "Repository deletion is destructive.")
prefix_rule(pattern = [["gh", "gh.exe"], "api"], decision = "forbidden", justification = "Use dedicated guarded/admin wrappers; generic API calls can mutate GitHub.")

# Dependency mutation remains an explicit approval boundary.
prefix_rule(pattern = ["uv", "add"], decision = "prompt", justification = "Changes dependencies and the lockfile.")
prefix_rule(pattern = ["uv", "remove"], decision = "prompt", justification = "Changes dependencies and the lockfile.")
prefix_rule(pattern = ["uv", "lock", "--upgrade"], decision = "prompt", justification = "May upgrade many dependencies.")
prefix_rule(pattern = ["pip", "install"], decision = "prompt", justification = "Mutates the Python environment.")
