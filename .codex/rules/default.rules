# .codex/rules/default.rules
#
# Autonomous development policy:
# - safe local/read operations may proceed
# - guarded task wrappers may create branch/commit/push/PR autonomously
# - final merge requires a human approval prompt
# - raw mutation paths are blocked

# ---------------------------------------------------------------------------
# Read-only Git inspection
# ---------------------------------------------------------------------------

prefix_rule(pattern = ["git", "status"], decision = "allow", justification = "Read-only repository inspection.")
prefix_rule(pattern = ["git", "diff"], decision = "allow", justification = "Read-only diff inspection.")
prefix_rule(pattern = ["git", "log"], decision = "allow", justification = "Read-only history inspection.")
prefix_rule(pattern = ["git", "show"], decision = "allow", justification = "Read-only object inspection.")
prefix_rule(pattern = ["git", "rev-parse"], decision = "allow", justification = "Read-only revision inspection.")
prefix_rule(pattern = ["git", "merge-base"], decision = "allow", justification = "Read-only revision calculation.")
prefix_rule(pattern = ["git", "ls-files"], decision = "allow", justification = "Read-only tracked-file listing.")
prefix_rule(pattern = ["git", "branch", "--show-current"], decision = "allow", justification = "Read-only current branch inspection.")

# ---------------------------------------------------------------------------
# Read-only GitHub operations used by CI/PR agents
# ---------------------------------------------------------------------------

prefix_rule(pattern = ["gh", "auth", "status"], decision = "allow", justification = "Read-only GitHub authentication status.")
prefix_rule(pattern = ["gh", "repo", "view"], decision = "allow", justification = "Read-only repository metadata.")
prefix_rule(pattern = ["gh", "pr", "view"], decision = "allow", justification = "Read-only pull request metadata.")
prefix_rule(pattern = ["gh", "pr", "diff"], decision = "allow", justification = "Read-only pull request diff.")
prefix_rule(pattern = ["gh", "pr", "checks"], decision = "allow", justification = "Read-only pull request CI status.")
prefix_rule(pattern = ["gh", "pr", "status"], decision = "allow", justification = "Read-only pull request status.")
prefix_rule(pattern = ["gh", "run", "list"], decision = "allow", justification = "Read-only Actions run listing.")
prefix_rule(pattern = ["gh", "run", "view"], decision = "allow", justification = "Read-only Actions run/log inspection.")

# ---------------------------------------------------------------------------
# Routine project validation
# These normally run inside the workspace sandbox.
# ---------------------------------------------------------------------------

prefix_rule(pattern = ["uv", "run", "pytest"], decision = "allow", justification = "Repository test execution.")
prefix_rule(pattern = ["uv", "run", "ruff", "check"], decision = "allow", justification = "Repository lint execution.")
prefix_rule(pattern = ["uv", "run", "ruff", "format", "--check"], decision = "allow", justification = "Formatting check.")
prefix_rule(pattern = ["uv", "run", "mypy"], decision = "allow", justification = "Static type checking.")

# ---------------------------------------------------------------------------
# Guarded autonomous workflow wrappers (PowerShell 7)
# ---------------------------------------------------------------------------

prefix_rule(
    pattern = ["pwsh", "-NoProfile", "-File", "scripts/agent/start-task.ps1"],
    decision = "allow",
    justification = "Creates only clean origin/main-based agent/* task branches and records task identity.",
)
prefix_rule(
    pattern = ["pwsh", "-NoProfile", "-File", "scripts/agent/commit-task.ps1"],
    decision = "allow",
    justification = "Commits only the recorded agent task with staged-path and message guards.",
)
prefix_rule(
    pattern = ["pwsh", "-NoProfile", "-File", "scripts/agent/push-task.ps1"],
    decision = "allow",
    justification = "Pushes only HEAD to the recorded agent/* branch on origin with no force option.",
)
prefix_rule(
    pattern = ["pwsh", "-NoProfile", "-File", "scripts/agent/create-pr.ps1"],
    decision = "allow",
    justification = "Creates only the recorded task PR with matching remote/local HEAD.",
)
prefix_rule(
    pattern = ["pwsh", "-NoProfile", "-File", "scripts/agent/wait-ci.ps1"],
    decision = "allow",
    justification = "Read-only polling of CI checks for the recorded task PR.",
)
prefix_rule(
    pattern = ["pwsh", "-NoProfile", "-File", "scripts/agent/merge-ready.ps1"],
    decision = "allow",
    justification = "Read-only final merge readiness gate that records the reviewed exact HEAD.",
)
prefix_rule(
    pattern = ["pwsh", "-NoProfile", "-File", "scripts/agent/merge-task.ps1"],
    decision = "prompt",
    justification = "Final merge is the human approval boundary and revalidates the exact approved HEAD.",
)

# Windows PowerShell equivalents.
prefix_rule(pattern = ["powershell.exe", "-NoProfile", "-File", "scripts/agent/start-task.ps1"], decision = "allow", justification = "Guarded task startup.")
prefix_rule(pattern = ["powershell.exe", "-NoProfile", "-File", "scripts/agent/commit-task.ps1"], decision = "allow", justification = "Guarded task commit.")
prefix_rule(pattern = ["powershell.exe", "-NoProfile", "-File", "scripts/agent/push-task.ps1"], decision = "allow", justification = "Guarded task push.")
prefix_rule(pattern = ["powershell.exe", "-NoProfile", "-File", "scripts/agent/create-pr.ps1"], decision = "allow", justification = "Guarded task PR creation.")
prefix_rule(pattern = ["powershell.exe", "-NoProfile", "-File", "scripts/agent/wait-ci.ps1"], decision = "allow", justification = "Read-only CI polling.")
prefix_rule(pattern = ["powershell.exe", "-NoProfile", "-File", "scripts/agent/merge-ready.ps1"], decision = "allow", justification = "Read-only merge readiness gate.")
prefix_rule(pattern = ["powershell.exe", "-NoProfile", "-File", "scripts/agent/merge-task.ps1"], decision = "prompt", justification = "Final human-approved merge.")

# One-time repository administration is never autonomous.
prefix_rule(
    pattern = ["pwsh", "-NoProfile", "-File", "scripts/github/configure-main-protection.ps1"],
    decision = "prompt",
    justification = "Changes server-side repository branch protection and requires explicit owner/admin approval.",
)
prefix_rule(
    pattern = ["pwsh", "-NoProfile", "-File", "scripts/github/verify-main-protection.ps1"],
    decision = "allow",
    justification = "Read-only branch protection verification.",
)

# ---------------------------------------------------------------------------
# Raw mutation paths: forbidden for Codex
# ---------------------------------------------------------------------------

prefix_rule(pattern = ["git", "add"], decision = "forbidden", justification = "Use guarded commit-task.ps1.")
prefix_rule(pattern = ["git", "commit"], decision = "forbidden", justification = "Use guarded commit-task.ps1.")
prefix_rule(pattern = ["git", "push"], decision = "forbidden", justification = "Use guarded push-task.ps1.")
prefix_rule(pattern = ["git", "switch"], decision = "forbidden", justification = "Use guarded start-task.ps1 for autonomous branches.")
prefix_rule(pattern = ["git", "checkout"], decision = "forbidden", justification = "Raw checkout can switch/discard outside the guarded workflow.")
prefix_rule(pattern = ["git", "restore"], decision = "forbidden", justification = "Raw restore can discard task/user changes.")
prefix_rule(pattern = ["git", "merge"], decision = "forbidden", justification = "Raw merge bypasses the final human gate.")
prefix_rule(pattern = ["git", "rebase"], decision = "forbidden", justification = "Raw rebase rewrites history.")
prefix_rule(pattern = ["git", "cherry-pick"], decision = "forbidden", justification = "Raw cherry-pick changes history outside the guarded workflow.")
prefix_rule(pattern = ["git", "reset", "--hard"], decision = "forbidden", justification = "Can irreversibly discard work.")
prefix_rule(pattern = ["git", "clean", "-fd"], decision = "forbidden", justification = "Can irreversibly delete untracked content.")
prefix_rule(pattern = ["git", "clean", "-fdx"], decision = "forbidden", justification = "Can irreversibly delete ignored/untracked content.")
prefix_rule(pattern = ["git", "push", "--force"], decision = "forbidden", justification = "Force push can overwrite remote history.")
prefix_rule(pattern = ["git", "push", "-f"], decision = "forbidden", justification = "Force push can overwrite remote history.")

prefix_rule(pattern = ["gh", "pr", "create"], decision = "forbidden", justification = "Use guarded create-pr.ps1.")
prefix_rule(pattern = ["gh", "pr", "merge"], decision = "forbidden", justification = "Use human-approved guarded merge-task.ps1.")
prefix_rule(pattern = ["gh", "pr", "close"], decision = "forbidden", justification = "Closing PRs is a remote mutation outside this autonomous workflow.")
prefix_rule(pattern = ["gh", "repo", "delete"], decision = "forbidden", justification = "Repository deletion is destructive.")
prefix_rule(pattern = ["gh", "api"], decision = "forbidden", justification = "Generic API calls can mutate GitHub; use dedicated guarded/admin wrappers.")

# Dependency mutation remains outside the default autonomous coding path.
prefix_rule(pattern = ["uv", "add"], decision = "prompt", justification = "Dependency additions change project metadata/lock state.")
prefix_rule(pattern = ["uv", "remove"], decision = "prompt", justification = "Dependency removal changes project metadata/lock state.")
prefix_rule(pattern = ["uv", "lock", "--upgrade"], decision = "prompt", justification = "Broad dependency upgrades can change many versions.")
prefix_rule(pattern = ["pip", "install"], decision = "prompt", justification = "Mutates the Python environment.")

prefix_rule(
    pattern = [
        "pwsh",
        "-NoProfile",
        "-File",
        "scripts/agent/github-preflight.ps1",
    ],
    decision = "allow",
    justification = "Guarded GitHub authentication and repository preflight.",
)

prefix_rule(
    pattern = [
        "pwsh",
        "-NoProfile",
        "-File",
        ".\\scripts\\agent\\github-preflight.ps1",
    ],
    decision = "allow",
    justification = "Windows-relative guarded GitHub preflight.",
)
